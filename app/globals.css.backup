@import "tailwindcss";

/* ==========================================================================
   DEV ARENA — DESIGN TOKENS
   Primary #007dcc · Secondary #ffb900 · Foundation #F0F8FF
   Support #d10056 · Support Neutral #6B7280
   ========================================================================== */

@theme {
  --font-display: var(--font-audiowide), ui-sans-serif, system-ui, sans-serif;
  --font-sans: var(--font-iceland), ui-sans-serif, system-ui, sans-serif;
  --font-mono: var(--font-ibm-plex-mono), ui-monospace, "SFMono-Regular", monospace;

  /* Ink — BLACK text for all non-sidebar content */
  --color-ink-950: #000000;
  --color-ink-900: #000000;
  --color-ink-850: #000000;
  --color-ink-800: #000000;
  --color-ink-700: #111111;
  --color-ink-600: #333333;
  --color-ink-500: #444444;
  --color-ink-400: #666666;
  --color-ink-300: #888888;
  --color-ink-200: #AAAAAA;

  /* Sand — ALICE BLUE foundation and surfaces */
  --color-sand-50: #F0F8FF;
  --color-sand-100: #E6F0FF;
  --color-sand-200: #CCE0FF;
  --color-sand-300: #99C2FF;
  --color-sand-400: #66A3FF;
  --color-sand-500: #3385FF;

  /* Primary — competitive, XP, action. Used deliberately and sparingly. */
  --color-primary: #007dcc;
  --color-primary-strong: #0066b3;
  --color-primary-soft: #3399dd;
  --color-primary-tint: #E6F2FF;
  --color-primary-line: #99CCFF;

  /* Secondary — gold, achievement, highlight */
  --color-secondary: #ffb900;
  --color-secondary-strong: #e6a700;
  --color-secondary-soft: #ffc733;
  --color-secondary-muted: #e6a700;
  --color-secondary-tint: #FFF8E6;
  --color-secondary-line: #FFE899;

  /* Support — unlocked, approved, healthy */
  --color-support: #d10056;
  --color-support-deep: #b2054c;
  --color-support-soft: #e84d8a;
  --color-support-tint: #FDEEF5;

  /* Supporting neutral */
  --color-hush: #6B7280;
  --color-hush-soft: #9CA3AF;
  --color-hush-tint: #F3F4F6;

  --radius-xs: 7px;
  --radius-sm: 7px;
  --radius-md: 7px;
  --radius-lg: 7px;
  --radius-xl: 7px;
  --radius-full: 9999px;

  --shadow-subtle: 0 1px 2px rgb(0 0 0 / 0.04), 0 1px 3px rgb(0 0 0 / 0.06);
  --shadow-raised: 0 2px 4px rgb(0 0 0 / 0.04), 0 8px 24px -8px rgb(0 0 0 / 0.12);
  --shadow-deep: 0 4px 8px rgb(0 0 0 / 0.06), 0 24px 48px -16px rgb(0 0 0 / 0.24);
  --shadow-inset-line: inset 0 1px 0 rgb(255 255 255 / 0.06);

  --animate-fade-up: fade-up 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  --animate-fade-in: fade-in 0.35s ease-out both;
  --animate-scale-in: scale-in 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
  --animate-xp-fill: xp-fill 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  --animate-sheen: sheen 1.1s ease-out 0.15s both;
  --animate-tick: tick 0.4s ease-out both;

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translate3d(0, 10px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes scale-in {
    from {
      opacity: 0;
      transform: scale3d(0.96, 0.96, 0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes xp-fill {
    from {
      width: 0%;
    }
  }

  @keyframes sheen {
    from {
      transform: translate3d(-110%, 0, 0);
    }
    to {
      transform: translate3d(210%, 0, 0);
    }
  }

  @keyframes tick {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.14);
    }
    100% {
      transform: scale(1);
    }
  }
}

@layer base {
  :root {
    color-scheme: light;
    --radius: 7px;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    background-color: var(--color-sand-100);
    color: var(--color-ink-800);
    font-family: var(--font-sans);
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    color: var(--color-ink-900);
    text-wrap: balance;
  }

  ::selection {
    background-color: color-mix(in oklab, var(--color-secondary) 40%, transparent);
    color: var(--color-ink-950);
  }

  :focus-visible {
    outline: 2px solid var(--color-secondary-muted);
    outline-offset: 2px;
    border-radius: 2px;
  }

  button,
  [role="button"] {
    -webkit-tap-highlight-color: transparent;
  }

  input,
  textarea,
  select,
  button {
    font: inherit;
    color: inherit;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--color-ink-300);
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: var(--color-sand-400) transparent;
  }

  *::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  *::-webkit-scrollbar-thumb {
    background-color: var(--color-sand-400);
    border: 3px solid transparent;
    border-radius: 999px;
    background-clip: content-box;
  }
}

@layer components {
  /* Technical label — used for section eyebrows, metadata, XP figures */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-400);
  }

  /* rule-dotted removed — no dotted dividers in the UI */

  /* Arena grid texture for hero surfaces */
  .arena-grid {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
  }
}

@utility stagger-1 {
  animation-delay: 60ms;
}
@utility stagger-2 {
  animation-delay: 120ms;
}
@utility stagger-3 {
  animation-delay: 180ms;
}
@utility stagger-4 {
  animation-delay: 240ms;
}
@utility stagger-5 {
  animation-delay: 300ms;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}

/* Hide browser password reveal eye */
input[type="password"]::-ms-reveal,
input[type="password"]::-webkit-credentials-auto-fill-button,
input[type="password"]::-webkit-contacts-auto-fill-button {
  display: none;
}
input[type="password"]::-ms-clear {
  display: none;
}